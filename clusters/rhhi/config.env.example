# Optional overrides for RHHI scripts. Primary values come from Terraform outputs (render-values.sh).
# Copy to config.env and customize as needed.

CLUSTER_NAME=rhhi
CLUSTER_DIR=rhhi
AWS_REGION=ap-southeast-2
AWS_ACCOUNT_ID=

ECR_REPOSITORY_PREFIX=quay-cache
TEKTON_NAMESPACE=user-workload-pipeline
ECR_OPERATOR_NAMESPACE=ecr-secret-operator

RHHI_BASE_IMAGE=hummingbird/python:3.11-runtime
RHHI_BUILDER_IMAGE=hummingbird/python:3.11-builder
DESTINATION_IMAGE=quay-cache/internal/hardened-app:1.0.0

# Path to repo root (auto-detected by scripts if unset)
# REPO_ROOT=/path/to/vp-terraform-rosa
