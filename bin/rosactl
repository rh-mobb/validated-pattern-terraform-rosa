def run_passthrough(root: Path, verb: str, cluster: str, robot: bool, verbose: bool, color: bool) -> int:
    parts = PASSTHROUGH[verb]
    step = Step(verb, ["bash", script(root, *parts), cluster])
    runner = StepRunner(root=root, cluster=cluster, verb=verb, robot=robot, verbose=verbose, color=color)
    result = runner.run_steps([step])
    if result.ok:
        return 0
    return EXIT_SIGINT if result.interrupted else 1


def _global_flags_parent() -> argparse.ArgumentParser:
    """Shared flags so they work before or after the verb (cobra-like)."""
    parent = argparse.ArgumentParser(add_help=False)
    parent.add_argument(
        "--robot",
        action="store_true",
        help="Full log stream (CI / non-interactive)",
    )
    parent.add_argument(
        "--verbose",
        action="store_true",
        help="Stream all log lines on a TTY",
    )
    return parent


def build_parser() -> tuple[argparse.ArgumentParser, argparse.ArgumentParser]:
    globals_parent = _global_flags_parent()
    parser = argparse.ArgumentParser(
        prog="rosactl",
        description="Human-friendly ROSA cluster lifecycle CLI (wraps repo scripts).",
        parents=[globals_parent],
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )

    resources = parser.add_subparsers(dest="resource", required=False, metavar="RESOURCE")
    cluster = resources.add_parser(
        "cluster",
        help="Cluster lifecycle operations",
        description="Manage a cluster directory under clusters/<name>.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )

    verbs = cluster.add_subparsers(dest="verb", required=False, metavar="VERB")
    for name, meta in CLUSTER_VERBS.items():
        verb_parser = verbs.add_parser(
            name,
            parents=[globals_parent],
            help=meta["help"],
            description=meta["description"],
            epilog=meta["epilog"],
            formatter_class=argparse.RawDescriptionHelpFormatter,
        )
        verb_parser.add_argument("name", help="Cluster directory name under clusters/")
        if name == "up":
            verb_parser.add_argument(
                "--no-bootstrap",
                action="store_true",
                help="Stop after apply (skip GitOps bootstrap)",
            )
        if name == "destroy":
            verb_parser.add_argument(
                "--yes",
                "-y",
                action="store_true",
                help="Skip interactive confirmation (required in --robot / CI)",
            )

    return parser, cluster


def confirm_destroy(cluster: str, *, yes: bool, robot: bool, color: bool) -> bool:
    """Confirm destroy in rosactl (not the bash script — prompts hang under our stdout pipe)."""
    if yes:
        return True
    if robot or not sys.stdin.isatty():
        print(
            c(
                "31",
                "Error: destroy requires confirmation. Re-run with --yes "
                "(or run interactively on a TTY).",
                color,
            ),
            file=sys.stderr,
        )
        return False
    print(c("33", "WARNING: This will destroy the infrastructure!", color))
    print(c("33", "AWS resources (cluster, VPC, IAM roles, etc.) will be deleted.", color))
    print(f"Cluster: {cluster}")
    try:
        answer = input("Type 'yes' to continue: ").strip()
    except EOFError:
        return False
    if answer != "yes":
        print("Destroy cancelled.")
        return False
    return True


def main(argv: Optional[Sequence[str]] = None) -> int:
    argv_list = list(sys.argv[1:] if argv is None else argv)
    parser, cluster_parser = build_parser()

    # No args → help (not a missing-argument error)
    if not argv_list:
        parser.print_help()
        return 0

    args = parser.parse_args(argv_list)

    if not args.resource:
        parser.print_help()
        return 0

    if args.resource != "cluster":
        parser.error("Only 'cluster' resource is supported in v1")

    if not getattr(args, "verb", None):
        cluster_parser.print_help()
        return 0

    root = project_root()
    color = use_color()
    verbose = bool(getattr(args, "verbose", False))
    robot_flag = bool(getattr(args, "robot", False))
    # --verbose: step headers + full live stream (no rolling viewport)
    # --robot / CI / non-TTY: full stream like Make
    robot_stream = is_robot_mode(robot_flag) and not verbose
    no_bootstrap = bool(getattr(args, "no_bootstrap", False))

    require_cluster(root, args.name)

    if args.verb == "destroy":
        if not confirm_destroy(
            args.name,
            yes=bool(getattr(args, "yes", False)),
            robot=robot_stream or robot_flag,
            color=color,
        ):
            return 1

    if args.verb in PASSTHROUGH:
        return run_passthrough(root, args.verb, args.name, robot_stream, verbose, color)

    steps = steps_for(root, args.verb, args.name, no_bootstrap=no_bootstrap)
    runner = StepRunner(
        root=root,
        cluster=args.name,
        verb=args.verb,
        robot=robot_stream,
        verbose=verbose,
        color=color,
    )
    result = runner.run_steps(steps)
    if result.ok:
        return 0
    return EXIT_SIGINT if result.interrupted else 1


if __name__ == "__main__":
    sys.exit(main())
